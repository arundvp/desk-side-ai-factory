# desk-side-ai-factory settings. Copy to lab.env and edit:  cp lab.env.example lab.env
# Every script in scripts/ sources this file. Run the scripts on Spark 1.

# --- Nodes -------------------------------------------------------------------
# Kubernetes node names (the Sparks' hostnames, as `hostname` prints them)
NODE1_NAME="spark-1"            # k3s server, runs vLLM replica 1
NODE2_NAME="spark-2"            # k3s agent, runs load generators, optional vLLM replica 2

# Management LAN (same values as NODE1_MGMT / NODE2_MGMT in dgx-spark-roce cluster.env)
NODE1_MGMT="192.168.1.11"
NODE2_MGMT="192.168.1.12"
MGMT_IF="enP7s7"                # interface that carries the management addresses
SSH_USER="${USER:-$(id -un)}"            # same user on both Sparks, passwordless SSH from Spark 1

# ConnectX-7 rails (only used by the PyTorch all_reduce job; from ~/.config/dgx-spark-roce/nccl.env)
RAIL_A_NODE1_IP="10.20.0.11"
NCCL_IB_HCA="rocep1s0f1,roceP2p1s0f1"
NCCL_SOCKET_IFNAME="enp1s0f1np1"
NCCL_IB_GID_INDEX=""            # leave empty for NCCL >= 2.21 (auto-selects the RoCE v2 GID)

# --- Versions (pinned 2026-10-29) ---------------------------------------------
K3S_VERSION="v1.36.5+k3s1"
GPU_OPERATOR_VERSION="v26.7.2"
KPS_VERSION="92.16.0"           # kube-prometheus-stack chart
VLLM_IMAGE="nvcr.io/nvidia/vllm:26.09-py3"
PYTORCH_IMAGE="nvcr.io/nvidia/pytorch:26.09-py3"
EXPORTER_IMAGE="python:3.12-slim"

# --- Model -----------------------------------------------------------------------
MODEL_ID="openai/gpt-oss-120b"
SERVED_MODEL_NAME="gpt-oss-120b"
LAB_DATA_DIR="/srv/spark-lab"   # host directory on each Spark: model cache, compile caches, results
# HF_TOKEN=""                   # not needed for gpt-oss-120b; set it for gated models

# --- Access --------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=""       # empty = generate one in 02-monitoring.sh and print it
NGC_API_KEY=""                  # only if pulls from nvcr.io fail with "unauthorized"
